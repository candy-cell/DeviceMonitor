<Window x:Class="DeviceMonitor.Shell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="设备监控上位机" Height="680" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <!-- 通用按钮 -->
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 主按钮（蓝） -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2F80ED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2F80ED"/>
        </Style>

        <!-- 左侧导航按钮 -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- 区块标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel>
                <TextBlock Text="设备监控" Foreground="White" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,24,0,32"/>
                <Button Content="📊 实时监控" Style="{StaticResource NavButton}"/>
                <Button Content="📈 历史趋势" Style="{StaticResource NavButton}"/>
                <Button Content="🚨 报警记录" Style="{StaticResource NavButton}"/>
                <Button Content="⚙️ 设备配置" Style="{StaticResource NavButton}"/>
                <Button Content="👤 用户管理" Style="{StaticResource NavButton}"/>
            </StackPanel>
        </Border>

        <!-- 右侧主内容 -->
        <Grid Grid.Column="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="实时监控" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ModeText}" Foreground="#E67E22" FontSize="13"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>

            <!-- 操作栏 -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="▶ 开始采集" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button Content="⏹ 停止采集" Command="{Binding StopCommand}" Margin="0,0,8,0"/>
                    <Button Content="📝 写操作" Command="{Binding WriteDemoCommand}" Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="13" Foreground="#555"/>
                </StackPanel>
            </Border>

            <!-- 配置栏 -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="串口号" VerticalAlignment="Center" FontSize="12" Foreground="#666" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" Width="70" Padding="4,3" Margin="0,0,14,0"/>
                        <TextBlock Text="从站地址" VerticalAlignment="Center" FontSize="12" Foreground="#666" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}" Width="46" Padding="4,3" Margin="0,0,14,0"/>
                        <TextBlock Text="波特率" VerticalAlignment="Center" FontSize="12" Foreground="#666" Margin="0,0,6,0"/>
                        <ComboBox SelectedItem="{Binding BaudRate}" Width="90" Padding="4,3" Margin="0,0,14,0"
                                  ItemsSource="{Binding BaudRateOptions}"/>
                        <TextBlock Text="数据位" VerticalAlignment="Center" FontSize="12" Foreground="#666" Margin="0,0,6,0"/>
                        <ComboBox SelectedItem="{Binding DataBits}" Width="56" Padding="4,3" Margin="0,0,14,0"
                                  ItemsSource="{Binding DataBitsOptions}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="停止位" VerticalAlignment="Center" FontSize="12" Foreground="#666" Margin="0,0,6,0"/>
                        <ComboBox SelectedItem="{Binding StopBits}" Width="56" Padding="4,3" Margin="0,0,14,0"
                                  ItemsSource="{Binding StopBitsOptions}"/>
                        <TextBlock Text="校验位" VerticalAlignment="Center" FontSize="12" Foreground="#666" Margin="0,0,6,0"/>
                        <ComboBox SelectedIndex="{Binding Parity}" Width="130" Padding="4,3" Margin="0,0,14,0"
                                  ItemsSource="{Binding ParityOptions}"/>
                        <Button Content="💾 保存配置" Command="{Binding SaveConfigCommand}" FontSize="12" Padding="10,4" Margin="0,0,14,0"/>
                        <Button Content="{Binding ModeText}" Command="{Binding ToggleModeCommand}" FontSize="12" Padding="10,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 内容：左测点，右报警 -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="实时数据" Style="{StaticResource SectionTitle}"/>
                        <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" BorderThickness="0"
                                  RowHeaderWidth="0" Background="Transparent"
                                  AlternatingRowBackground="#F8FAFC">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="测点" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="数值" Binding="{Binding Value, StringFormat=F1}" Width="70"/>
                                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="50"/>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="报警记录" Style="{StaticResource SectionTitle}"/>
                        <DataGrid ItemsSource="{Binding Alarms}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" BorderThickness="0"
                                  RowHeaderWidth="0" Background="Transparent"
                                  AlternatingRowBackground="#FDF2F2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="56"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="84"/>
                                <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*"/>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 底部状态栏 -->
            <StatusBar Grid.Row="4" Margin="0,8,0,0" Background="Transparent">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="#27AE60"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                            <Setter Property="Fill" Value="#E74C3C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionText}" FontSize="12" Foreground="#333"/>
                    </StackPanel>
                </StatusBarItem>
                <Separator/>
                <StatusBarItem>
                    <TextBlock FontSize="12">
                        <Run Text="用户："/><Run Text="{Binding CurrentUserName}" FontWeight="Bold"/>
                        <Run Text="   角色："/>
                        <Run Text="{Binding RoleText}">
                            <Run.Style>
                                <Style TargetType="Run">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanWrite}" Value="True">
                                            <Setter Property="Foreground" Value="#27AE60"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanWrite}" Value="False">
                                            <Setter Property="Foreground" Value="#E74C3C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Run.Style>
                        </Run>
                    </TextBlock>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
