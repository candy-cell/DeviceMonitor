<Window x:Class="DeviceMonitor.Shell.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 - 设备监控上位机" Height="320" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#2C3E50" FontFamily="Microsoft YaHei UI">
    <Grid Margin="0">
        <StackPanel VerticalAlignment="Center" Margin="40,0">
            <TextBlock Text="设备监控上位机" FontSize="22" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="工业数据采集与监控系统" FontSize="12"
                       Foreground="#BDC3C7" HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <TextBlock Text="用户名" Foreground="#BDC3C7" Margin="0,0,0,4"/>
            <TextBox x:Name="UserNameBox" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,5" Margin="0,0,0,12" Background="White" BorderThickness="0"/>

            <TextBlock Text="密码" Foreground="#BDC3C7" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"
                         Padding="8,5" Margin="0,0,0,12" Background="White" BorderThickness="0"
                         KeyDown="PasswordBox_KeyDown"/>

            <TextBlock Text="{Binding Error}" Foreground="#FF6B6B" Margin="0,0,0,8"
                       TextWrapping="Wrap" FontSize="12"/>

            <Button Content="登 录" Command="{Binding LoginCommand}"
                    Background="#2F80ED" Foreground="White" BorderThickness="0"
                    Padding="0,8" FontSize="15" Cursor="Hand"
                    IsDefault="True"/>

            <TextBlock Text="默认：admin / admin123（管理员）" FontSize="11"
                       Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock Text="operator / operator123（操作员）" FontSize="11"
                       Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>
    </Grid>
</Window>
